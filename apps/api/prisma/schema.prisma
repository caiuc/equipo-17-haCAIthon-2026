generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  COMPANY_ADMIN
  DRIVER
  PASSENGER
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum DriverStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum DayType {
  WEEKDAY
  SATURDAY
  SUNDAY
}

enum TripStatus {
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum ReportSource {
  DRIVER
  PASSENGER
}

/// Privada o municipal. No decide la tarifa: gratis es una fila de Fare con
/// amountClp 0, no una consecuencia de ser municipal. Existe para explicar por
/// que una empresa no tiene rut y para distinguir el servicio en la interfaz.
enum CompanyKind {
  PRIVATE
  MUNICIPAL
}

enum PassengerType {
  ADULT
  STUDENT
  SENIOR
}

/// Region administrativa (ej. "Region Metropolitana"). Nace sembrada; nuevas
/// regiones no se crean desde la app, solo zonas dentro de las existentes.
model Region {
  id    String @id @default(cuid())
  name  String @unique
  zones Zone[]
}

/// Zona/ciudad dentro de una region (ej. "Talagante"). Vive en el recorrido, NO
/// en la empresa: una empresa puede operar en mas de una zona, y asociar la zona
/// a la empresa mezclaria "quien presta el servicio" con "donde". Cualquier
/// empresa puede crear una zona nueva al editar un recorrido; el alta hace
/// upsert case-insensitive para que "Talagante" y "talagante" no queden como dos
/// filas distintas.
model Zone {
  id       String @id @default(cuid())
  regionId String
  name     String

  region Region  @relation(fields: [regionId], references: [id], onDelete: Cascade)
  routes Route[]

  @@unique([regionId, name])
}

/// Empresa o cooperativa rural. Para la demo se crean pre-aprobadas (ACTIVE).
model Company {
  id String @id @default(cuid())

  /// Clave natural estable entre corridas del seed. El rut no sirve para esto:
  /// de las ocho empresas sembradas solo una lo publica, y los servicios
  /// municipales no tienen. Un upsert por rut nulo no es valido en Prisma.
  slug String @unique

  name String
  rut  String?     @unique
  kind CompanyKind @default(PRIVATE)

  /// Color de marca con el que se pintan sus micros en el mapa y en la lista.
  color String @default("#1B5FC1")

  /// Sprite de la micro. Es el nombre de un archivo de
  /// frontend/public/assets/micros/, NO una URL: se valida contra la lista
  /// blanca de packages/shared antes de que el cliente arme la ruta.
  assetSlug String @default("generico")

  phone   String?
  website String?

  /// De donde salio la ficha de esta empresa y cuando se consulto. El principio
  /// rector vale tambien para el dato estatico: la tarifa de Damir que circula
  /// en prensa es de julio de 2022, y mostrarla sin fecha seria presentar como
  /// vigente un dato de hace cuatro anos.
  sourceUrl       String?
  sourceCheckedAt DateTime?

  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  users  User[]
  routes Route[]
  trips  Trip[]
  buses  Bus[]
}

/// Tarifa publicada de un recorrido, por tipo de pasajero.
///
/// Modelo aparte y no columnas en Route porque la AUSENCIA de fila significa
/// "no publicada", y eso no es lo mismo que 0: MuniBus Paine es gratuito de
/// verdad, mientras que cuatro de las ocho empresas simplemente no publican su
/// tarifa. Colapsar ambos casos en un Int con default 0 haria que la interfaz
/// dijera "Gratis" donde en realidad no sabemos.
///
/// Sin vigencia temporal a proposito: una tarifa historica no responde ninguna
/// pregunta de alguien parado en un paradero.
model Fare {
  id            String        @id @default(cuid())
  routeId       String
  passengerType PassengerType
  /// Pesos chilenos, entero: el pasaje no tiene decimales.
  amountClp     Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  // El unique compuesto ya deja routeId como columna lider del indice.
  @@unique([routeId, passengerType])
}

/// Vehiculo concreto de la flota. Opcional en todo el flujo: el chofer puede
/// iniciar turno sin declarar en que micro va y el mapa se pinta igual, cayendo
/// al sprite de la empresa. Sin tabla de tipos de vehiculo: lo unico que varia
/// entre micros es la patente y los asientos, y el dibujo lo define la empresa.
model Bus {
  id        String @id @default(cuid())
  companyId String
  plate     String
  seats     Int?
  /// Override del sprite de la empresa, para la flota que no se ve como el resto.
  assetSlug String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trips   Trip[]

  @@unique([companyId, plate])
}

/// Un solo modelo para los cuatro roles. Los campos de chofer (licenseNumber,
/// driverStatus) van aqui en vez de en un DriverProfile 1:1 para evitar un join
/// en el camino mas transitado del sistema.
model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  name          String
  role          Role
  companyId     String?
  licenseNumber String?
  driverStatus  DriverStatus?
  /// La empresa crea la cuenta del chofer con una clave temporal.
  mustChangePassword Boolean  @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trips   Trip[]

  @@index([companyId])
}

/// Cada sentido es un recorrido propio, tal como los lista el PDF de Bupesa
/// ("desde Terminal Penaflor" y "desde Terminal San Borja" son tablas distintas).
model Route {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  code            String
  originName      String
  destinationName String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// Zona geografica del recorrido, la gestiona la empresa. Opcional: un
  /// recorrido sin zona asignada esta "pendiente", nunca se infiere una.
  zoneId String?

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  zone      Zone?       @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  stops     RouteStop[]
  schedules Schedule[]
  fares     Fare[]
  trips     Trip[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([zoneId])
}

/// El orden explicito (stopOrder) es lo que permite razonar sobre el avance.
model RouteStop {
  id        String @id @default(cuid())
  routeId   String
  name      String
  lat       Float
  lng       Float
  stopOrder Int

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, stopOrder])
  @@index([routeId])
}

/// Horarios referenciales del PDF: primera y ultima salida por tipo de dia.
/// Se guardan como "HH:mm" porque es un dato de referencia, no un timestamp.
model Schedule {
  id             String  @id @default(cuid())
  routeId        String
  dayType        DayType
  firstDeparture String
  lastDeparture  String

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, dayType])
  @@index([routeId])
}

/// Turno: instancia de un chofer recorriendo una ruta. Se crea ad-hoc cuando el
/// chofer pulsa "iniciar recorrido". companyId va denormalizado porque el filtro
/// multitenant es el chequeo mas repetido del sistema.
model Trip {
  id        String     @id @default(cuid())
  routeId   String
  driverId  String
  companyId String
  status    TripStatus @default(IN_TRANSIT)
  startedAt DateTime   @default(now())
  endedAt   DateTime?

  /// Opcional: exigirlo romperia POST /api/driver/trips/start, que hoy solo
  /// recibe routeId, y dejaria turnos imposibles de iniciar si la empresa aun no
  /// cargo su flota. Cuando es null el mapa usa el sprite de la empresa y no
  /// inventa una patente que no conoce.
  busId String?

  route     Route              @relation(fields: [routeId], references: [id], onDelete: Cascade)
  driver    User               @relation(fields: [driverId], references: [id], onDelete: Cascade)
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bus       Bus?               @relation(fields: [busId], references: [id], onDelete: SetNull)
  positions Position[]
  reports   OccupancyReport[]

  @@index([routeId, status])
  @@index([driverId, status])
  @@index([companyId, status])
}

/// Muestreo del recorrido: la ultima posicion vive en memoria y aqui solo baja
/// una cada POSITION_SAMPLE_INTERVAL_MS. recordedAt es el dato que habilita
/// todo el calculo de frescura.
model Position {
  id         String   @id @default(cuid())
  tripId     String
  lat        Float
  lng        Float
  speed      Float?
  heading    Float?
  recordedAt DateTime

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, recordedAt])
}

/// Reporte colaborativo de ocupacion. Un voto por reporterKey (deviceId anonimo
/// o userId), actualizable: la persona puede corregir a "ya no va llena".
model OccupancyReport {
  id          String       @id @default(cuid())
  tripId      String
  reporterKey String
  source      ReportSource
  full        Boolean
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, reporterKey])
  @@index([tripId, updatedAt])
}
