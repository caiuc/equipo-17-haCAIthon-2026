PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://equipo17:equipo17@localhost:5434/equipo17?schema=public

# Firma de los tokens. En desarrollo puede omitirse (hay un default),
# pero el API se niega a arrancar en produccion con el secreto de dev.
# Generar uno con: openssl rand -base64 32
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=12h

# Cuantos proxies hay delante, para que el rate limit vea la IP real del cliente.
# 0 en local, 1 detras del ALB, 2 detras de CloudFront + ALB (lo que usa ECS).
TRUST_PROXY=0

# --- Trazados de los recorridos (tools/trazados) ---
# Clave de servidor con la Routes API de Google habilitada. Se usa UNA vez, para
# calcular el trazado por calles de cada recorrido y guardarlo en
# Route.pathPolyline; el API en marcha no la necesita.
#
# VACIA a proposito: la clave real va en .env, que esta gitignoreado. Cada
# llamada se cobra, asi que el script no re-pide un recorrido que ya tiene
# trazado (--force lo obliga) y --dry-run dice el costo sin gastar nada.
ROUTES_API_KEY=
