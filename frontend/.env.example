# cp .env.example .env

# Mapa del pasajero. Sin esta clave la vista muestra un placeholder en vez del mapa.
VITE_GOOGLE_MAPS_API_KEY=

# Map ID vectorial (consola de Google Cloud > Map Management). Lo exige
# AdvancedMarker, y AdvancedMarker es lo unico que puede rotar el sprite de la
# micro segun su rumbo. Sin el, la vista tambien muestra el placeholder.
VITE_GOOGLE_MAPS_MAP_ID=

# Solo si el API vive en otro origen. Vacio = rutas relativas /api, que es lo
# correcto tanto en dev (proxy de Vite) como en produccion (mismo CloudFront).
VITE_API_URL=
