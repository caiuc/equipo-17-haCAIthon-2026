# Copia este archivo a .env y ajusta lo que necesites:
#   cp .env.example .env
# docker-compose lee este archivo para levantar Postgres.

# --- Postgres (docker compose) ---
POSTGRES_USER=equipo17
POSTGRES_PASSWORD=equipo17
POSTGRES_DB=equipo17
# 5434 para no chocar con otros Postgres corriendo en el host.
POSTGRES_PORT=5434

# --- API ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://equipo17:equipo17@localhost:5434/equipo17?schema=public

# --- Web (build de produccion) ---
# En dev no hace falta: Vite proxea /api hacia el backend.
VITE_API_URL=
